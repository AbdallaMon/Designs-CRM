# Courses web app
#
# Key names and order mirror courses-web/.env.production. For local usage:
#   Copy-Item courses-web/.env.example courses-web/.env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
# Origins must not end with a trailing slash.

# Backend origin. The shared client adds `/v2`; do not include it here.
NEXT_PUBLIC_API=http://localhost:4001
# Same backend origin, used for sockets and file links.
NEXT_PUBLIC_URL=http://localhost:4001
# Main web app origin. Unauthenticated users are redirected here to log in.
NEXT_PUBLIC_WEB_URL=http://localhost:3001
