generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// إعدادات عامة للموقع (Singleton: سجل واحد فقط)
model SiteUtility {
  id               Int      @id @default(1)
  pdfFrame         String?  @db.VarChar(1024)
  pdfHeader        String?  @db.VarChar(1024)
  updatedAt        DateTime @default(now()) @updatedAt @db.DateTime(0)
  introPage        String?
  pageTitle        String?
  pdfSignaturePart String?
}

model ContractUtility {
  id                    Int                             @id
  obligationsPartyOneAr String                          @db.Text
  obligationsPartyOneEn String                          @db.Text
  obligationsPartyTwoAr String                          @db.Text
  obligationsPartyTwoEn String                          @db.Text
  updatedAt             DateTime                        @default(now()) @updatedAt
  levelClauses          ContractLevelClauseTemplate[]
  specialClauses        ContractSpecialClauseTemplate[]
  stageClauses          ContractStageClauseTemplate[]
}

model ContractStageClauseTemplate {
  id                Int             @id @default(autoincrement())
  contractUtilityId Int
  headingAr         String          @db.Text
  headingEn         String          @db.Text
  titleAr           String          @db.Text
  titleEn           String          @db.Text
  descriptionAr     String          @db.Text
  descriptionEn     String          @db.Text
  order             Int             @default(0)
  contractUtility   ContractUtility @relation(fields: [contractUtilityId], references: [id])

  @@index([contractUtilityId])
}

model ContractSpecialClauseTemplate {
  id                Int             @id @default(autoincrement())
  contractUtilityId Int
  textAr            String          @db.Text
  textEn            String?         @db.Text
  order             Int             @default(0)
  isActive          Boolean         @default(true)
  contractUtility   ContractUtility @relation(fields: [contractUtilityId], references: [id])

  @@index([contractUtilityId])
}

model ContractLevelClauseTemplate {
  id                Int             @id @default(autoincrement())
  contractUtilityId Int
  level             ContractLevel
  textAr            String          @db.Text
  textEn            String?         @db.Text
  order             Int             @default(0)
  isActive          Boolean         @default(true)
  contractUtility   ContractUtility @relation(fields: [contractUtilityId], references: [id])

  @@index([contractUtilityId])
  @@index([level])
}

model Contract {
  id                      Int                   @id @default(autoincrement())
  clientLeadId            Int
  contractLevel           ContractLevel
  title                   String?               @db.VarChar(255)
  startDate               DateTime?             @db.DateTime(0)
  endDate                 DateTime?             @db.DateTime(0)
  createdAt               DateTime              @default(now()) @db.DateTime(0)
  purpose                 String?               @db.VarChar(255)
  isCompleted             Boolean               @default(false)
  isInProgress            Boolean               @default(false)
  pdfLinkAr               String?               @db.VarChar(1024)
  pdfLinkEn               String?               @db.VarChar(1024)
  signatureUrl            String?               @db.Text
  handWrittenSignatureUrl String?               @db.Text
  projectType             String?
  writtenAt               DateTime?             @db.DateTime(0)
  status                  ContractStatus        @default(IN_PROGRESS)
  taxRate                 Decimal               @default(0.00) @db.Decimal(5, 2)
  amount                  Decimal?              @db.Decimal(12, 2)
  totalAmount             Decimal?              @db.Decimal(12, 2)
  projectGroupId          Int?
  arToken                 String?               @db.VarChar(64)
  enToken                 String?               @db.VarChar(64)
  sessionStatus           ContractSessionStatus @default(INITIAL)
  enTitle                 String?
  clientLead              ClientLead            @relation(fields: [clientLeadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Contract_ibfk_1")
  drawings                ContractDrawing[]
  paymentsNew             ContractPayment[]
  specialItems            ContractSpecialItem[]
  stages                  ContractStage[]
  notes                   Note[]
  projects                Project[]

  @@index([clientLeadId], map: "idx_contract_clientLeadId")
}

/// المرحلة الجديدة بدل enum، مع عدد أيام المرحلة + عدد أيام القسم
model ContractStage {
  id               Int               @id @default(autoincrement())
  contractId       Int
  title            String
  order            Int
  deliveryDays     Int
  deptDeliveryDays Int?
  projectId        Int?
  startDate        DateTime?         @db.DateTime(0)
  endDate          DateTime?         @db.DateTime(0)
  stageStatus      StageStatus       @default(NOT_STARTED)
  payments         ContractPayment[]
  contract         Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id])
  deliverySchedule DeliverySchedule?

  @@unique([contractId, order])
  @@index([projectId])
  @@index([contractId])
  @@index([stageStatus], map: "idx_contractstage_stageStatus")
}

model ContractPayment {
  id               Int                       @id @default(autoincrement())
  contractId       Int
  stageId          Int?
  amount           Decimal                   @db.Decimal(12, 2)
  amountLost       Decimal                   @default(0.00) @db.Decimal(12, 2)
  amountReceived   Decimal                   @default(0.00) @db.Decimal(12, 2)
  currency         String                    @default("AED") @db.VarChar(16)
  dueDate          DateTime?                 @db.DateTime(0)
  status           String                    @default("NOT_DUE") @db.VarChar(16)
  reference        String?
  note             String?                   @db.Text
  createdAt        DateTime                  @default(now()) @db.DateTime(0)
  updatedAt        DateTime                  @default(now()) @updatedAt @db.DateTime(0)
  projectId        Int?
  paymentCondition String?                   @db.VarChar(100)
  conditionId      Int?
  conditionItem    ContractPaymentCondition? @relation(fields: [conditionId], references: [id])
  contract         Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stage            ContractStage?            @relation(fields: [stageId], references: [id])
  project          Project?                  @relation(fields: [projectId], references: [id], map: "fk_contractpayment_project")

  @@index([contractId])
  @@index([stageId])
  @@index([status, dueDate])
  @@index([conditionId])
  @@index([projectId], map: "idx_contractpayment_projectId")
}

model ContractPaymentCondition {
  id            Int               @id @default(autoincrement())
  conditionType String            @db.VarChar(191)
  condition     String            @db.VarChar(191)
  labelAr       String            @db.VarChar(191)
  labelEn       String            @db.VarChar(191)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  payments      ContractPayment[]

  @@unique([conditionType, condition, labelAr, labelEn], map: "ContractPaymentCondition_unique_business_key")
}

model ContractDrawing {
  id           Int      @id @default(autoincrement())
  contractId   Int
  url          String   @db.VarChar(1024)
  fileName     String?  @db.VarChar(255)
  mimeType     String?
  sizeBytes    Int?
  uploadedAt   DateTime @default(now()) @db.DateTime(0)
  uploadedById Int?
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

/// البنود الخاصة ثنائية اللغة (العربي إلزامي/الإنجليزي اختياري)
model ContractSpecialItem {
  id         Int      @id @default(autoincrement())
  contractId Int
  labelAr    String   @db.Text
  labelEn    String?  @db.Text
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ClientLeadUpdate {
  id             Int            @id @default(autoincrement())
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  status         UpdateStatus   @default(IN_PROGRESS)
  createdAt      DateTime?      @default(now()) @db.DateTime(0)
  updatedAt      DateTime?      @default(now()) @updatedAt @db.DateTime(0)
  createdById    Int
  clientLeadId   Int
  isArchived     Boolean        @default(false)
  department     String         @default("STAFF") @db.VarChar(255)
  isDone         Boolean        @default(false)
  createdBy      User           @relation(fields: [createdById], references: [id], onUpdate: Restrict, map: "ClientLeadUpdate_ibfk_1")
  clientLead     ClientLead     @relation(fields: [clientLeadId], references: [id], onUpdate: Restrict, map: "ClientLeadUpdate_ibfk_2")
  notes          Note[]
  sharedSettings SharedUpdate[]

  @@index([clientLeadId], map: "clientLeadId")
  @@index([createdById], map: "createdById")
}

model SharedUpdate {
  id                Int              @id @default(autoincrement())
  updateId          Int
  type              String           @db.VarChar(255)
  isArchived        Boolean?         @default(false)
  createdAt         DateTime?        @default(now()) @db.DateTime(0)
  updatedAt         DateTime?        @default(now()) @updatedAt @db.DateTime(0)
  excludeFromSearch Boolean          @default(false)
  notes             Note[]
  update            ClientLeadUpdate @relation(fields: [updateId], references: [id], onUpdate: Restrict, map: "SharedUpdate_ibfk_1")

  @@index([updateId], map: "updateId")
}

model SalesStage {
  id           Int            @id @default(autoincrement())
  clientLeadId Int
  userId       Int?
  stage        SalesStageType
  createdAt    DateTime?      @default(now()) @db.DateTime(0)
  notes        Note[]
  clientLead   ClientLead     @relation(fields: [clientLeadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_salesStage_clientLead")
  user         User?          @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_salesStage_user")

  @@unique([clientLeadId, stage], map: "clientLead_stage_unique")
  @@index([clientLeadId], map: "idx_clientLeadId")
  @@index([userId], map: "idx_userId")
}

model TelegramChannel {
  id           Int        @id @default(autoincrement())
  clientLeadId Int        @unique(map: "clientLeadId")
  channelLink  String     @db.VarChar(255)
  channelId    BigInt     @unique(map: "channelId")
  description  String?    @db.Text
  createdAt    DateTime?  @default(now()) @db.DateTime(0)
  accessHash   BigInt
  clientLead   ClientLead @relation(fields: [clientLeadId], references: [id], onUpdate: Restrict, map: "TelegramChannel_ibfk_1")
}

model TelegramConnection {
  id                      Int                      @id @default(autoincrement())
  name                    String                   @unique @default("MAIN") @db.VarChar(100)
  apiId                   String?
  apiHash                 String?
  sessionString           String?                  @db.Text
  isActive                Boolean                  @default(true)
  status                  TelegramConnectionStatus @default(DISCONNECTED)
  phoneNumber             String?                  @db.VarChar(20)
  lastCheckedAt           DateTime?
  lastConnectedAt         DateTime?
  lastError               String?                  @db.Text
  notifiedOfDisconnection Boolean                  @default(false)
  updatedByUserId         Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  updatedBy               User?                    @relation("TelegramConnectionUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([isActive])
  @@index([updatedByUserId])
}

model ClientLead {
  id                   Int                         @id @default(autoincrement())
  clientId             Int
  userId               Int?
  selectedCategory     LeadCategory
  type                 LeadType                    @default(CONSTRUCTION_VILLA)
  description          String?
  discount             Decimal                     @default(0.00) @db.Decimal(10, 2)
  emirate              Emirate?
  price                String?
  averagePrice         Decimal?                    @db.Decimal(10, 2)
  priceWithOutDiscount Decimal                     @default(0.00) @db.Decimal(10, 2)
  status               ClientLead_status           @default(NEW)
  assignedAt           DateTime?
  reasonToConvert      String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  clientDescription    String?                     @db.Text
  stripieMetadata      String?                     @db.LongText
  timeToContact        DateTime?                   @db.DateTime(0)
  country              String?                     @db.VarChar(255)
  priceNote            String?                     @db.Text
  accountantId         Int?
  paymentStatus        PaymentStatus?              @default(PENDING)
  accountantAssignedAt DateTime?                   @db.DateTime(0)
  ourCost              String?                     @db.VarChar(255)
  contractorCost       String?                     @db.VarChar(255)
  commissionCleared    Boolean?                    @default(false)
  paymentSessionId     String?                     @db.VarChar(255)
  telegramLink         String?                     @db.VarChar(255)
  initialConsult       Boolean?                    @default(true)
  leadType             LeadConversionType          @default(NORMAL)
  previousLeadId       Int?
  personality          ClientPersonality?
  discoverySource      ClientLead_discoverySource?
  finalizedDate        DateTime?                   @db.DateTime(0)
  code                 String?                     @unique
  stateOfTheProject    String?                     @db.Text
  location             String?                     @db.VarChar(255)
  projectType          String?                     @db.VarChar(255)
  projectStage         String?                     @db.VarChar(255)
  previousWork         String?                     @db.Text
  hasArchitecturalPlan String?                     @db.VarChar(255)
  serviceType          String?                     @db.VarChar(255)
  decisionMaker        String?                     @db.VarChar(255)
  bookingRequestStatus BookingLeadRequestStatus    @default(IN_PROGRESS)
  bookingSubmittedAt   DateTime?
  callReminders        CallReminder[]              @relation("clientLeadCallReminders")
  chatRooms            ChatRoom[]
  imageSessions        ClientImageSession[]
  client               Client                      @relation(fields: [clientId], references: [id])
  assignedTo           User?                       @relation(fields: [userId], references: [id])
  accountant           User?                       @relation("AccountantLeads", fields: [accountantId], references: [id], onUpdate: Restrict, map: "fk_accountant")
  updates              ClientLeadUpdate[]
  commissions          Commission[]
  contracts            Contract[]
  driveNodeLinks       DriveNodeClientLead[]
  extraServices        ExtraService[]
  lastTelegramMessages FetchedTelegramMessage[]
  files                File[]
  meetingReminders     MeetingReminder[]           @relation("clientLeadMeetingReminders")
  notes                Note[]
  notifications        Notification[]
  payments             Payment[]
  priceOffers          PriceOffers[]
  projects             Project[]
  salesStages          SalesStage[]
  sessionQuestions     SessionQuestion[]
  tasks                Task[]
  telegramChannel      TelegramChannel?
  versaModel           VersaModel[]

  @@index([clientId])
  @@index([userId])
  @@index([accountantId], map: "fk_accountant")
}

model FetchedTelegramMessage {
  id           Int        @id @default(autoincrement())
  clientLeadId Int
  messageId    Int?
  fetchedAt    DateTime?  @default(now()) @db.DateTime(0)
  clientLead   ClientLead @relation(fields: [clientLeadId], references: [id], onUpdate: Restrict, map: "fk_clientLeadId")

  @@index([clientLeadId], map: "idx_clientLeadId")
}

model MeetingReminder {
  id                                                           Int                 @id @default(autoincrement())
  clientLeadId                                                 Int
  time                                                         DateTime?           @db.DateTime(0)
  status                                                       CallReminderStatus? @default(IN_PROGRESS)
  meetingResult                                                String?             @db.Text
  reminderReason                                               String?             @db.Text
  userId                                                       Int
  createdAt                                                    DateTime?           @default(now()) @db.DateTime(0)
  updatedAt                                                    DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  isAdmin                                                      Boolean             @default(false)
  adminId                                                      Int?
  type                                                         MeetingType?
  availableSlotId                                              Int?                @unique(map: "availableSlotId")
  token                                                        String?             @unique(map: "token")
  userTimezone                                                 String?             @db.VarChar(100)
  notified                                                     Boolean             @default(false)
  notified4h                                                   Boolean             @default(false)
  notified12h                                                  Boolean             @default(false)
  googleEventId                                                String?             @db.VarChar(255)
  googleCalendarSynced                                         Boolean             @default(false)
  availableSlot                                                AvailableSlot?      @relation("SlotToMeeting")
  deliverySchedules                                            DeliverySchedule[]
  admin                                                        User?               @relation("AdminMeetingReminders", fields: [adminId], references: [id], onUpdate: Restrict, map: "fk_admin_user")
  clientLead                                                   ClientLead          @relation("clientLeadMeetingReminders", fields: [clientLeadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_meeting_clientLead")
  AvailableSlot_MeetingReminder_availableSlotIdToAvailableSlot AvailableSlot?      @relation("MeetingReminder_availableSlotIdToAvailableSlot", fields: [availableSlotId], references: [id], onUpdate: Restrict, map: "fk_meeting_slot")
  user                                                         User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_meeting_user")

  @@index([adminId], map: "idx_adminId")
  @@index([clientLeadId], map: "idx_clientLeadId")
  @@index([userId], map: "idx_userId")
}

model DeliverySchedule {
  id                Int              @id @default(autoincrement())
  projectId         Int?
  name              String?          @db.VarChar(255)
  deliveryAt        DateTime         @db.DateTime(0)
  meetingReminderId Int?
  createdById       Int?
  createdAt         DateTime         @default(now()) @db.DateTime(0)
  stageId           Int?             @unique
  stage             ContractStage?   @relation(fields: [stageId], references: [id])
  createdBy         User?            @relation("DeliverySchedulesCreatedBy", fields: [createdById], references: [id], map: "fk_DeliverySchedule_createdBy")
  meeting           MeetingReminder? @relation(fields: [meetingReminderId], references: [id], map: "fk_DeliverySchedule_meeting")
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_DeliverySchedule_project")
  notes             Note[]

  @@index([createdById], map: "idx_DeliverySchedule_createdById")
  @@index([deliveryAt], map: "idx_DeliverySchedule_deliveryAt")
  @@index([meetingReminderId], map: "idx_DeliverySchedule_meetingReminderId")
  @@index([projectId], map: "idx_DeliverySchedule_projectId")
}

model Commission {
  id               Int        @id @default(autoincrement())
  userId           Int
  leadId           Int
  amount           Decimal    @db.Decimal(10, 2)
  amountPaid       Decimal    @default(0.00) @db.Decimal(10, 2)
  createdAt        DateTime   @default(now()) @db.DateTime(0)
  isCleared        Boolean    @default(false)
  commissionReason String     @default("Finalized Lead Commission") @db.VarChar(255)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Commission_ibfk_1")
  lead             ClientLead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Commission_ibfk_2")
  notes            Note[]

  @@index([leadId], map: "leadId")
  @@index([userId], map: "userId")
}

model Project {
  id                Int                @id @default(autoincrement())
  clientLeadId      Int
  deliveryTime      DateTime?
  priority          Priority           @default(MEDIUM)
  area              Decimal?           @db.Decimal(10, 2)
  startedAt         DateTime?
  endedAt           DateTime?
  status            String
  // When `status` last changed (stamped by the app's single status-write path).
  // Null on rows predating the column — readers fall back to updatedAt/createdAt.
  statusChangedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  type              String
  role              Project_role?      @default(THREE_D_DESIGNER)
  groupTitle        String             @default("Initial Project") @db.VarChar(255)
  groupId           Int                @default(1)
  isModification    Boolean            @default(false)
  notified7Days     Boolean?           @default(false)
  notified3Days     Boolean?           @default(false)
  notified2Days     Boolean?           @default(false)
  notified1Day      Boolean?           @default(false)
  contractId        Int?
  assignments       Assignment[]
  chatRooms         ChatRoom[]
  chatRoomProjects  ChatRoomProject[]  @relation("ChatRoomProjects")
  payments          ContractPayment[]
  contractStages    ContractStage[]
  deliverySchedules DeliverySchedule[]
  driveNodeLinks    DriveNodeProject[]
  clientLead        ClientLead         @relation(fields: [clientLeadId], references: [id])
  contract          Contract?          @relation(fields: [contractId], references: [id], map: "fk_project_contract")
  tasks             Task[]

  @@index([clientLeadId])
  @@index([groupId])
  @@index([contractId], map: "idx_project_contractId")
}

model Task {
  id           Int         @id @default(autoincrement())
  title        String      @db.VarChar(255)
  description  String?     @db.Text
  status       TaskStatus  @default(TODO)
  priority     Priority    @default(MEDIUM)
  createdAt    DateTime    @default(now())
  dueDate      DateTime?
  finishedAt   DateTime?
  projectId    Int?
  userId       Int?
  type         String      @default("NORMAL")
  createdById  Int?
  clientLeadId Int?
  updatedAt    DateTime?   @updatedAt @db.DateTime(0)
  notes        Note[]
  clientLead   ClientLead? @relation(fields: [clientLeadId], references: [id], onUpdate: Restrict, map: "FK_Task_ClientLead")
  createdBy    User?       @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_Task_CreatedBy")
  project      Project?    @relation(fields: [projectId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([clientLeadId], map: "FK_Task_ClientLead")
  @@index([createdById], map: "FK_Task_CreatedBy")
}

model Payment {
  id            Int            @id @default(autoincrement())
  clientLeadId  Int
  status        PaymentStatus? @default(PENDING)
  amount        Decimal        @db.Decimal(10, 2)
  amountPaid    Decimal?       @default(0.00) @db.Decimal(10, 2)
  amountLeft    Decimal        @db.Decimal(10, 2)
  createdAt     DateTime?      @default(now()) @db.DateTime(0)
  updatedAt     DateTime?      @default(now()) @updatedAt @db.DateTime(0)
  paymentReason String?        @db.Text
  paymentLevel  String?        @db.VarChar(255)
  invoices      Invoice[]
  notes         Note[]
  clientLead    ClientLead     @relation(fields: [clientLeadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Payment_ibfk_1")

  @@index([clientLeadId], map: "clientLeadId")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  paymentId     Int
  issuedDate    DateTime? @default(now()) @db.DateTime(0)
  amount        Decimal   @db.Decimal(10, 2)
  createdAt     DateTime? @default(now()) @db.DateTime(0)
  invoiceNumber String?   @unique(map: "invoiceNumber") @db.VarChar(20)
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Invoice_ibfk_1")
  notes         Note[]

  @@index([paymentId], map: "fk_payment_id")
}

model ExtraService {
  id           Int        @id @default(autoincrement())
  clientLeadId Int
  price        Decimal    @db.Decimal(10, 2)
  note         String?    @db.Text
  createdAt    DateTime?  @default(now()) @db.DateTime(0)
  clientLead   ClientLead @relation(fields: [clientLeadId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ExtraService_ibfk_1")

  @@index([clientLeadId], map: "clientLeadId")
}

model PriceOffers {
  id           Int        @id @default(autoincrement())
  clientLeadId Int
  userId       Int
  minPrice     Decimal?   @db.Decimal(10, 2)
  maxPrice     Decimal?   @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  url          String?    @db.VarChar(255)
  note         String?    @db.Text
  isAccepted   Boolean?   @default(false)
  clientLead   ClientLead @relation(fields: [clientLeadId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([clientLeadId])
  @@index([userId], map: "PriceOffers_userId_fkey")
}

model CallReminder {
  id             Int                @id @default(autoincrement())
  clientLeadId   Int
  time           DateTime
  status         CallReminderStatus @default(IN_PROGRESS)
  callResult     String?            @db.Text
  reminderReason String?            @db.Text
  userId         Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  notified       Boolean            @default(false)
  clientLead     ClientLead         @relation("clientLeadCallReminders", fields: [clientLeadId], references: [id])
  user           User               @relation(fields: [userId], references: [id])

  @@index([clientLeadId])
  @@index([userId])
}

model File {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(255)
  url          String     @db.VarChar(255)
  description  String?    @db.Text
  clientLeadId Int
  isUserFile   Boolean    @default(true)
  createdAt    DateTime   @default(now())
  userId       Int?
  clientLead   ClientLead @relation(fields: [clientLeadId], references: [id])
  user         User?      @relation(fields: [userId], references: [id])

  @@index([clientLeadId, isUserFile])
  @@index([userId], map: "File_userId_fkey")
}

model User {
  id                                                       Int                    @id @default(autoincrement())
  email                                                    String                 @unique @db.VarChar(255)
  name                                                     String                 @db.VarChar(255)
  password                                                 String                 @db.VarChar(255)
  isActive                                                 Boolean                @default(true)
  role                                                     UserRole?              @default(STAFF)
  createdAt                                                DateTime               @default(now())
  updatedAt                                                DateTime               @updatedAt
  lastSeenAt                                               DateTime?              @db.DateTime(0)
  maxLeadsCounts                                           Int?                   @default(50)
