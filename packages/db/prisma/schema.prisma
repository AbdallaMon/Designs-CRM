// ── DB-relational permissions (design 2026-07-03) ────────────────────────────
// PermissionCode = one row per permission code (seeded from ALL_PERMISSIONS).
model PermissionCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(191)
  module      String   @db.VarChar(64)
  label       String?  @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  profileLinks ProfilePermission[]

  @@index([module])
}

// Profile = a named permission profile (seeded from PROFILE_META).
model Profile {
  id           Int       @id @default(autoincrement())
  key          String    @unique @db.VarChar(64)
  label        String    @db.VarChar(191)
  family       String?   @db.VarChar(64)
  baseRole     UserRole?
  isAdminTier  Boolean   @default(false)
  sortOrder    Int       @default(0)
  isAssignable Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissionLinks ProfilePermission[]
  userLinks       UserProfile[]
  currentForUsers User[]              @relation("CurrentProfile")
}

// Profile ↔ PermissionCode — what each profile grants.
model ProfilePermission {
  id               Int      @id @default(autoincrement())
  profileId        Int
  permissionCodeId Int
  createdAt        DateTime @default(now())

  profile        Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ProfilePermission_profile_fk")
  permissionCode PermissionCode @relation(fields: [permissionCodeId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ProfilePermission_code_fk")

  @@unique([profileId, permissionCodeId])
  @@index([permissionCodeId])
}

// User ↔ Profile — assignment (replaces subRoles). A user may hold many.
model UserProfile {
  id               Int      @id @default(autoincrement())
  userId           Int
  profileId        Int
  assignedByUserId Int?
  createdAt        DateTime @default(now())

  user       User    @relation("UserProfiles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "UserProfile_user_fk")
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "UserProfile_profile_fk")
  assignedBy User?   @relation("UserProfileAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "UserProfile_assignedby_fk")

  @@unique([userId, profileId])
  @@index([profileId])
  @@index([assignedByUserId])
}

// Minimal authz audit — first audit pattern in the repo.
model AuthAuditLog {
  id           Int      @id @default(autoincrement())
  actorUserId  Int
  targetUserId Int?
  action       String   @db.VarChar(64)
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
}

// Rich, semantic, append-only ACTION audit trail (admin-only viewer). Distinct from
// AuthAuditLog (which is authorization-only). Written from usecases after successful
// writes via the non-blocking `recordAction` service. Purely additive — no relations on
// the frozen User/ClientLead models; joins are done by id in the repo.
model ActionAuditLog {
  id           Int      @id @default(autoincrement())
  actorUserId  Int
  actorRole    String?  @db.VarChar(48)
  module       String   @db.VarChar(48)
  action       String   @db.VarChar(64)
  entityType   String?  @db.VarChar(48)
  entityId     Int?
  clientLeadId Int?
  summary      String?  @db.VarChar(255)
  detail       Json?
  ip           String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([clientLeadId])
  @@index([module, action])
  @@index([createdAt])
}
