model Outcome {
  id                                                                   Int                   @id @default(autoincrement())
  type                                                                 String?               @db.VarChar(50)
  amount                                                               Decimal?              @db.Decimal(10, 2)
  description                                                          String?               @db.Text
  createdAt                                                            DateTime?             @default(now()) @db.DateTime(0)
  updatedAt                                                            DateTime?             @default(now()) @updatedAt @db.DateTime(0)
  // Prod reality: these are scalar FK columns on Outcome (one Outcome -> one salary/expense/rent-period).
  // The old schema's `[]` list back-relations here were a wrong inverse model and collided with these
  // scalar column names, so they were removed; the correct to-one relations are declared below.
  rentPeriods                                                          Int?
  operationalExpenses                                                  Int?
  monthlySalaries                                                      Int?
  MonthlySalary_Outcome_monthlySalariesToMonthlySalary                 MonthlySalary?        @relation("Outcome_monthlySalariesToMonthlySalary", fields: [monthlySalaries], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_monthly_salaries")
  OperationalExpenses_Outcome_operationalExpensesToOperationalExpenses OperationalExpenses?  @relation("Outcome_operationalExpensesToOperationalExpenses", fields: [operationalExpenses], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_operational_expense")
  RentPeriod_Outcome_rentPeriodsToRentPeriod                           RentPeriod?           @relation("Outcome_rentPeriodsToRentPeriod", fields: [rentPeriods], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rent_period")
  // Opposite sides of the SECOND (distinct) FK direction: <model>.outcomeId -> Outcome.id
  // (prod FKs MonthlySalary_ibfk_3 / OperationalExpenses_ibfk_1 / RentPeriod_ibfk_2).
  // db pull could not name these because the scalar column names above were taken; named explicitly here.
  monthlySalariesByOutcome                                             MonthlySalary[]       @relation("MonthlySalaryToOutcome")
  operationalExpensesByOutcome                                         OperationalExpenses[] @relation("OperationalExpensesToOutcome")
  rentPeriodsByOutcome                                                 RentPeriod[]          @relation("RentPeriodToOutcome")

  @@index([operationalExpenses], map: "fk_operational_expense")
  @@index([rentPeriods], map: "fk_rent_period")
  @@index([monthlySalaries], map: "idx_monthly_salaries")
}

