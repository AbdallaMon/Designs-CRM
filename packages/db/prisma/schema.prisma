model DriveNode {
  id              Int                   @id @default(autoincrement())
  type            DriveNodeType
  visibility      DriveVisibility       @default(PRIVATE)
  ownerId         Int
  parentId        Int?
  name            String                @db.VarChar(255)
  storageProvider StorageProvider       @default(LOCAL)
  storageKey      String?               @db.VarChar(1024)
  mimeType        String?               @db.VarChar(120)
  sizeBytes       BigInt?               @default(0)
  checksum        String?               @db.VarChar(128)
  isDeleted       Boolean               @default(false)
  deletedAt       DateTime?             @db.DateTime(0)
  createdAt       DateTime              @default(now()) @db.DateTime(0)
  updatedAt       DateTime              @default(now()) @updatedAt @db.DateTime(0)
  acl             DriveAcl[]
  owner           User                  @relation(fields: [ownerId], references: [id], onUpdate: Restrict, map: "fk_DriveNode_owner")
  parent          DriveNode?            @relation("DriveNodeChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_DriveNode_parent")
  children        DriveNode[]           @relation("DriveNodeChildren")
  nodeClientLeads DriveNodeClientLead[]
  nodeProjects    DriveNodeProject[]
  publicShares    DrivePublicShare[]

  @@index([isDeleted], map: "idx_DriveNode_isDeleted")
  @@index([ownerId], map: "idx_DriveNode_ownerId")
  @@index([parentId], map: "idx_DriveNode_parentId")
  @@index([visibility], map: "idx_DriveNode_visibility")
}

model DriveAcl {
  id        Int       @id @default(autoincrement())
  nodeId    Int
  userId    Int
  canView   Boolean   @default(true)
  canUpload Boolean   @default(false)
  canEdit   Boolean   @default(false)
  canDelete Boolean   @default(false)
  canShare  Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.DateTime(0)
  node      DriveNode @relation(fields: [nodeId], references: [id], onUpdate: Restrict, map: "fk_DriveAcl_node")
  user      User      @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_DriveAcl_user")

  @@unique([nodeId, userId], map: "uq_DriveAcl_node_user")
  @@index([nodeId], map: "idx_DriveAcl_nodeId")
  @@index([userId], map: "idx_DriveAcl_userId")
}

model DrivePublicShare {
  id           Int       @id @default(autoincrement())
  nodeId       Int
  createdById  Int
  token        String    @unique(map: "uq_DrivePublicShare_token") @db.VarChar(80)
  expiresAt    DateTime? @db.DateTime(0)
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime? @db.DateTime(0)
  passwordHash String?   @db.VarChar(255)
  canView      Boolean   @default(true)
  canDownload  Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.DateTime(0)
  createdBy    User      @relation(fields: [createdById], references: [id], onUpdate: Restrict, map: "fk_DrivePublicShare_createdBy")
  node         DriveNode @relation(fields: [nodeId], references: [id], onUpdate: Restrict, map: "fk_DrivePublicShare_node")

  @@index([createdById], map: "idx_DrivePublicShare_createdById")
  @@index([nodeId], map: "idx_DrivePublicShare_nodeId")
}

model DriveNodeProject {
  id        Int       @id @default(autoincrement())
  nodeId    Int
  projectId Int
  createdAt DateTime  @default(now()) @db.DateTime(0)
  node      DriveNode @relation(fields: [nodeId], references: [id], onUpdate: Restrict, map: "fk_DriveNodeProject_node")
