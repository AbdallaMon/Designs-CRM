model ChatRoom {
  id                  Int                    @id @default(autoincrement())
  type                ChatRoom_type
  name                String?                @db.VarChar(255)
  avatarUrl           String?                @db.VarChar(500)
  projectId           Int?
  clientLeadId        Int?
  allowFiles          Boolean                @default(true)
  allowCalls          Boolean                @default(true)
  isChatEnabled       Boolean                @default(true)
  createdById         Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  allowChatForMembers Boolean                @default(false)
  allowMeetings       Boolean                @default(false)
  chatAccessToken     String?                @unique(map: "uq_chatroom_chatAccessToken") @db.VarChar(255)
  calls               Call[]
  members             ChatMember[]
  messages            ChatMessage[]
  pinnedMessages      ChatPinnedMessage[]
  clientLead          ClientLead?            @relation(fields: [clientLeadId], references: [id])
  createdBy           User?                  @relation("ChatRoomCreator", fields: [createdById], references: [id])
  project             Project?               @relation(fields: [projectId], references: [id])
  multiProjectRooms   ChatRoomProject[]
  scheduledMessages   ChatScheduledMessage[]

  @@index([type])
  @@index([projectId])
  @@index([clientLeadId])
  @@index([createdById])
}

model ChatMember {
  id            Int               @id @default(autoincrement())
  roomId        Int
  userId        Int?
  clientId      Int?
  role          ChatMemberRole    @default(MEMBER)
  isMuted       Boolean           @default(false)
  isPinned      Boolean           @default(false)
  lastReadAt    DateTime?
  notifyOnReply Boolean           @default(true)
  joinedAt      DateTime          @default(now())
  leftAt        DateTime?
  isArchived    Boolean           @default(false)
  createdAt     DateTime          @default(now()) @db.DateTime(0)
  isDeleted     Boolean           @default(false)
  client        Client?           @relation(fields: [clientId], references: [id])
  room          ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id])
  readReceipts  ChatReadReceipt[]
  typingStatus  ChatTypingStatus?

  @@unique([roomId, userId])
  @@unique([roomId, clientId])
  @@index([roomId])
  @@index([userId])
  @@index([clientId])
  @@index([userId, leftAt])
  @@index([roomId, leftAt])
}

model ChatMessage {
  id              Int                @id @default(autoincrement())
  roomId          Int
  senderId        Int?
  senderClient    Int?
  type            ChatMessageType
  content         String?            @db.Text
  fileUrl         String?            @db.VarChar(500)
  fileName        String?            @db.VarChar(255)
  fileSize        Int?
  fileMimeType    String?            @db.VarChar(100)
  replyToId       Int?
  forwardedFromId Int?
  isEdited        Boolean            @default(false)
  isDeleted       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attachments     ChatAttachment[]
  bookmarks       ChatBookmark[]
  mentions        ChatMention[]
  forwardedFrom   ChatMessage?       @relation("ForwardedMessage", fields: [forwardedFromId], references: [id])
  forwardedTo     ChatMessage[]      @relation("ForwardedMessage")
  replyTo         ChatMessage?       @relation("MessageReply", fields: [replyToId], references: [id])
  replies         ChatMessage[]      @relation("MessageReply")
  room            ChatRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  client          Client?            @relation(fields: [senderClient], references: [id])
  sender          User?              @relation(fields: [senderId], references: [id])
  pinnedIn        ChatPinnedMessage?
  reactions       ChatReaction[]
  readReceipts    ChatReadReceipt[]

  @@index([roomId])
  @@index([senderId])
  @@index([senderClient])
  @@index([replyToId])
  @@index([forwardedFromId])
  @@index([createdAt])
  @@index([roomId, createdAt])
  @@index([roomId, isDeleted])
  @@index([senderId, createdAt])
