# Canonical Prisma/database environment
#
# Local usage:
#   Copy-Item packages/db/prisma/.env.example packages/db/prisma/.env
#
# The backend also needs the same DATABASE_URL in server/.env. Never point a
# development migration command at production. URL-encode special characters
# in the username/password.

DATABASE_URL=mysql://dms_user:change-me@127.0.0.1:3306/dream_studio
NODE_ENV=development

# Used only when `npm run db:seed` finds no existing admin-tier user.
# Generate the hash before seeding:
# node -e "require('bcrypt').hash('replace-with-a-strong-password',12).then(console.log)"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
