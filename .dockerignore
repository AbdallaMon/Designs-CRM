# Keep the Docker build context lean + never bake secrets/build output into images.
# Shared by both images (server/Dockerfile and web/Dockerfile) — build context = repo ROOT.

# dependencies (each image installs only the workspaces it needs)
**/node_modules
.git
.gitignore
.github

# the legacy rich frontend — NOT part of either deployable image (web/ is the
# registered frontend workspace; ui/ is an untracked work-in-progress copy).
ui

# secrets / env (provided at runtime by the platform, never copied into the image)
.env
.env.*
!.env.example
.cookies.txt

# build output / generated (Next build runs in-image; Prisma client is regenerated)
web/.next
web/out
**/.next
**/dist
**/build

# logs, docs, editor + OS junk
*.log
.server.log
docs/html
.idea
.vscode
.DS_Store
Thumbs.db
