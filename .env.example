# Dream Studio backend environment
#
# Local usage:
#   Copy-Item .env.example server/.env
#
# Deployment:
#   Add the same keys to the backend service environment. Do not commit real
#   credentials. URLs and origins must not end with a trailing slash.

# Runtime
NODE_ENV=development
PORT=4001
ISLOCAL=true

# Database
# Keep this value synchronized with packages/db/prisma/.env.
# URL-encode special characters in the username/password.
DATABASE_URL=mysql://dms_user:change-me@127.0.0.1:3306/dream_studio

# Authentication
# Generate a different random value for every secret, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-different-random-reset-secret
JWT_UPLOAD_SECRET=replace-with-a-different-random-upload-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h
JWT_UPLOAD_EXPIRES_IN=10m

# Cookie scope
# Keep blank for local development. In production use the shared parent domain,
# for example: .example.com
COOKIE_DOMAIN=

# Backend/public URLs
SERVER_URL=http://localhost:4001
CRM_DOMAIN=http://localhost:4001
CRM_ORIGIN=http://localhost:3001
DASHBOARD_ORIGIN=http://localhost:3001
COURSES_ORIGIN=http://localhost:4011
PORTFOLIO_DOMAIN=http://localhost:3001
PORTFOLIO_ORIGIN=http://localhost:3001
CONTACT_ORIGIN=http://localhost:3001
BOOKING_ORIGIN=http://localhost:3001

# CORS
# Exact comma-separated origins. Do not add paths or trailing slashes.
ALLOW_ORIGIN=http://localhost:3001,http://localhost:4011
# Optional comma-separated base domains whose subdomains are trusted.
ALLOWED_DOMAINS=

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# On a multi-instance deployment, enable these on only one designated instance.
RUN_WORKERS=true
RUN_CRON=true

# Local file storage
UPLOADS_PATH=uploads
UPLOAD_DIR=uploads
TEMP_UPLOAD_DIR=uploads/temp
THUMBNAIL_DIR=uploads/thumb
# Bytes: 1 GiB and 100 MiB.
MAX_FILE_SIZE=1073741824
MAX_FILE_SIZE_FOR_CLIENT=104857600

# SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=change-me
CLIENT_EMAIL_FROM=client@example.com

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/v2/calendar/google/callback

# Stripe
STRIPE_SECRET_KEY=

# Telegram / GramJS
TELE_API_ID=
TELE_API_HASH=
TELEGRAM_SESSION=

# Protected client-payment backfill endpoint
BACKFILL_SECRET=replace-with-a-random-backfill-secret
