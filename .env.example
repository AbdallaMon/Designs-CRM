# Dream Studio backend environment
#
# Key names and order mirror server/.env. Values here are safe local examples;
# never copy production credentials into this file.

# Runtime
ISLOCAL=true
PORT=4001
SERVER_URL=http://localhost:4001

# Database
DATABASE_URL=mysql://dms_user:change-me@127.0.0.1:3306/dream_studio

# Frontend domains and CORS
CRM_DOMAIN=http://localhost:3001
DASHBOARD_ORIGIN=http://localhost:3001
PORTFOLIO_ORIGIN=http://localhost:3001
PORTFOLIO_DOMAIN=http://localhost:3001
COURSES_ORIGIN=http://localhost:4011
COURSES_DOMAIN=http://localhost:4011
CONTACT_ORIGIN=http://localhost:3001
BOOKING_ORIGIN=http://localhost:3001
ALLOW_ORIGIN=http://localhost:3001,http://localhost:4011

# Authentication
# Generate independent random values for every secret.
SECRET_KEY=replace-with-a-random-legacy-secret
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-random-reset-secret
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

# SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=change-me
CLIENT_EMAIL_FROM=client@example.com

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/v2/calendar/google/callback

# Telegram / GramJS
TELEGRAM_BOT_TOKEN=
TELE_API_ID=
TELE_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION=

# Stripe (STRIPE_PUPLISH keeps the current legacy spelling.)
STRIPE_PUPLISH=
STRIPE_SECRET_KEY=
STRIPE_UNIT_AMOUNT=0

# FTP
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Nextcloud
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Upload storage
UPLOADS_PATH=uploads
UPLOAD_DIR=uploads
TEMP_UPLOAD_DIR=uploads/temp
THUMBNAIL_DIR=uploads/thumb
MAX_FILE_SIZE=1073741824
MAX_FILE_SIZE_FOR_CLIENT=104857600
INTEGRATION_CREDENTIALS_MASTER_KEY=replace-with-32-byte-base64-secret
# Private document storage and signed delivery
IMAGE_DOMAIN=http://localhost:3001
ASSET_STORAGE_ROOT=C:/dreamstudiio-storage
# Telegram URL buttons require this origin to be publicly reachable; use an HTTPS tunnel for local testing.
ASSET_DELIVERY_ORIGIN=http://localhost:4001
ASSET_URL_SIGNING_SECRET=replace-with-an-independent-random-secret
ASSET_URL_TTL_SECONDS=3600
ASSET_EMAIL_URL_TTL_SECONDS=604800
ASSET_URL_MAX_TTL_SECONDS=604800
ASSET_CONTENT_RATE_LIMIT=3000
UPLOAD_LEGACY_ORIGINS=https://dreamstudiio.com,https://panel.dreamstudiio.com,http://localhost:3001,http://localhost:4001
LEGACY_UPLOAD_DIR=C:/home/dreamstudiio.com/public_html/uploads
