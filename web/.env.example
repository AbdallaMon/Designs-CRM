# Main Dream Studio web app
#
# Key names and order mirror web/.env. NEXT_PUBLIC_* values are embedded in
# the browser bundle, so never put a private credential in them.

NEXT_PUBLIC_URL=https://test-api.dreamstudiio.com
NEXT_PUBLIC_WEB_URL=https://test-web.dreamstudiio.com
NEXT_PUBLIC_PROTOCOL=https
NEXT_PUBLIC_HOST=test-web.dreamstudiio.com
NEXT_PUBLIC_COURSES_URL=https://test-courses.dreamstudiio.com
# Optional: when omitted, lead emails are copied without opening a webmail page.
NEXT_PUBLIC_WEBMAIL_URL=https://mail.example.com/
