# Main Dream Studio web app
#
# Local usage:
#   Copy-Item web/.env.example web/.env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
# Origins must not end with a trailing slash and must not include `/v2`.

# Express API and Socket.IO origin.
NEXT_PUBLIC_API=http://localhost:4001
NEXT_PUBLIC_URL=http://localhost:4001

# Courses application link shown in the main navigation.
NEXT_PUBLIC_COURSES_URL=http://localhost:4011

# Server-side Next.js rewrite target for relative `/uploads/*` URLs.
UPLOADS_ORIGIN=http://localhost:4001

# Optional Shopify Storefront integration. These values are public by design,
# but should still be configured through the deployment environment.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
